        </svg>
        <span class="mdn-logo-text">목동늘사랑교회</span>
      </div>
      <!-- nav -->
      <nav class="mdn-nav-list">
        <a href="#" class="mdn-nav-link">교회 안내</a>
        <a href="#" class="mdn-nav-link">교육 훈련</a>
        <a href="#" class="mdn-nav-link">선교</a>
        <a href="#" class="mdn-nav-link">자료실</a>
